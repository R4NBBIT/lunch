rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 구글 계정으로 로그인한 본인인지
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && 'google.com' in request.auth.token.firebase.identities;
    }

    // 관리자: secret/admins 문서의 emails 목록에 있는 구글 계정 (이메일 인증된 계정만)
    function isAdmin() {
      return request.auth != null
        && 'google.com' in request.auth.token.firebase.identities
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/secret/admins).data.emails;
    }

    // 식당 프리셋 형식: 이름, 출발 위치, 동, 걸어서 몇 분, 고른 종류, 식당 목록, 뽑기에서 뺀 식당
    function validPreset(d) {
      return d.keys().hasOnly(['name', 'origin', 'dong', 'minutes', 'kinds', 'items', 'skip'])
        && d.name is string && d.name.size() <= 20
        && d.origin is map
        && d.dong is string && d.dong.size() <= 40
        && d.minutes in [5, 10, 15, 20, 30]
        && d.kinds is list && d.kinds.size() <= 40
        && d.items is list && d.items.size() <= 2000
        && d.skip is list && d.skip.size() <= 2000;
    }

    // 내 메뉴판: 추가한 메뉴, 숨긴 기본 메뉴
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['added', 'hidden'])
        && request.resource.data.added is list && request.resource.data.added.size() <= 200
        && request.resource.data.hidden is list && request.resource.data.hidden.size() <= 300;
    }

    // 내 식당 프리셋 3개 (p1, p2, p3)
    match /users/{uid}/presets/{pid} {
      allow read, delete: if isOwner(uid) && pid in ['p1', 'p2', 'p3'];
      allow create, update: if isOwner(uid) && pid in ['p1', 'p2', 'p3'] && validPreset(request.resource.data);
    }

    // 기본 메뉴판: 누구나 읽고, 관리자만 고치거나 지움 (지우면 코드에 있는 처음 목록으로 돌아감)
    match /config/menus {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['menus'])
        && request.resource.data.menus is list
        && request.resource.data.menus.size() <= 500;
      allow delete: if isAdmin();
    }

    // 관리자 확인용 (화면에서 관리자 기능을 보여줄지 판단)
    match /admin/probe {
      allow get: if isAdmin();
    }

    // secret/* 를 포함한 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
