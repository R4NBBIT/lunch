rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 메뉴판(lists/menus)과 맛집 목록(lists/places) 두 문서만 열어둠
    match /lists/{listId} {
      allow read: if listId in ['menus', 'places'];

      // 추가·삭제: items 목록 하나만, 최대 300개까지
      allow create, update: if listId in ['menus', 'places']
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 300;

      // 초기화: 관리자(구글 로그인한 본인)만 문서를 지워 기본 목록으로 되돌림
      allow delete: if listId in ['menus', 'places']
        && request.auth != null
        && request.auth.uid == 'OWNER_UID_HERE';
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
